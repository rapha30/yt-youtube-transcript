# Normalize all text to LF in the repository (keeps Linux CI gofmt/Makefile/shell happy
# regardless of a contributor's core.autocrlf setting).
* text=auto eol=lf

*.go     text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
*.md     text eol=lf
